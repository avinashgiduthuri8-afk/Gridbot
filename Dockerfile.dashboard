# Standalone Dashboard service Dockerfile for VPS / Docker deployment:
# Builds the React frontend and serves it together with the FastAPI backend.

# ---- Stage 1: build the React frontend ----
FROM node:20-slim AS frontend-builder

WORKDIR /app/grid-dashboard

COPY grid-dashboard/package.json grid-dashboard/package-lock.json* ./

RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY grid-dashboard/ ./

RUN npm run build

# ---- Stage 2: Python backend serving the built frontend ----
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY grid-trading-bot/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY grid-trading-bot/ .

# Frontend build output lands at dashboard/static
COPY --from=frontend-builder /app/grid-dashboard/dist ./dashboard/static

RUN mkdir -p data logs \
    && useradd --create-home --uid 1000 dashboarduser \
    && chown -R dashboarduser:dashboarduser /app
USER dashboarduser

EXPOSE 8000

CMD ["sh", "-c", "uvicorn dashboard.app:app --host 0.0.0.0 --port ${DASHBOARD_PORT:-8000}"]
