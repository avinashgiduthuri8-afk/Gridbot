# Combined single-service Dockerfile for VPS / Docker deployment:
# Runs both the trading engine AND the embedded read-only FastAPI dashboard
# (API + built frontend) from a single container (main.py).
# Set DASHBOARD_EMBEDDED_ENABLED=true in .env to enable the embedded dashboard.

# ---- Stage 1: build the React frontend ----
FROM node:20-slim AS frontend-builder

WORKDIR /workspace/grid-dashboard
COPY grid-dashboard/package.json ./
RUN npm install

COPY grid-dashboard/ ./
RUN npm run build

# ---- Stage 2: Python bot + embedded dashboard ----
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DASHBOARD_EMBEDDED_ENABLED=true

WORKDIR /app

COPY grid-trading-bot/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# google-auth is optional for Google Drive backups
RUN pip install --no-cache-dir google-auth==2.35.0

COPY grid-trading-bot/ .

# Frontend build output lands at dashboard/static where dashboard/config.py expects it
COPY --from=frontend-builder /workspace/grid-dashboard/dist ./dashboard/static

RUN mkdir -p data logs \
    && useradd --create-home --uid 1000 botuser \
    && chown -R botuser:botuser /app
USER botuser

EXPOSE 8000

CMD ["python", "main.py"]
