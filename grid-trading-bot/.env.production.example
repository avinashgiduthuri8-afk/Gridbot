# ==============================================================================
# GridBot Production Environment Configuration (VPS / Docker Compose)
# Copy this file to .env on the production VPS and fill in your real credentials.
# NEVER commit the real .env file to version control.
# ==============================================================================

# ==============================================================================
# 1. REQUIRED PRODUCTION SECRETS
# ==============================================================================

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=<SET_ON_SERVER>

# Numeric Telegram User ID from @userinfobot (authorized owner)
TELEGRAM_CHAT_ID=<SET_ON_SERVER>

# CoinDCX API Key (Trade permission only; NO withdrawal permission)
COINDCX_API_KEY=<SET_ON_SERVER>

# CoinDCX API Secret (HMAC-SHA256 signing secret)
COINDCX_API_SECRET=<SET_ON_SERVER>


# ==============================================================================
# 2. REQUIRED PRODUCTION CONFIGURATION
# ==============================================================================

# SQLite database file path (must reside on persistent VPS disk / Docker volume)
DATABASE_PATH=data/grid_bot.db

# Directory for rotating log files
LOG_DIR=logs

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CoinDCX REST API base URL
COINDCX_BASE_URL=https://api.coindcx.com


# ==============================================================================
# 3. ACCESS CONTROL & RISK MANAGEMENT (INR)
# ==============================================================================

# Optional: comma-separated list of additional authorized Telegram user IDs
TELEGRAM_ALLOWED_USER_IDS=

# Maximum total capital (INR) deployed across all active grids combined
MAX_TOTAL_CAPITAL=50000

# Maximum capital (INR) allocated to any single coin
MAX_CAPITAL_PER_COIN=20000

# Maximum number of grids that can run simultaneously (1 - 20)
MAX_SIMULTANEOUS_GRIDS=20

# Minimum free INR wallet balance reserve required before opening new orders
MIN_WALLET_BALANCE=500

# Maximum daily realized loss (INR) before emergency trading halt
DAILY_LOSS_LIMIT=2000


# ==============================================================================
# 4. ENGINE TIMING & POLLING INTERVALS (Seconds)
# ==============================================================================

# Interval between order-monitor status poll cycles (seconds)
ORDER_POLL_INTERVAL_SECONDS=8

# Interval between price ticker checks per grid (seconds)
PRICE_POLL_INTERVAL_SECONDS=5

# Interval between periodic Telegram daily summaries (86400 = 24 hours)
DAILY_SUMMARY_INTERVAL_SECONDS=86400


# ==============================================================================
# 5. READ-ONLY DASHBOARD CONFIGURATION
# ==============================================================================

# Set to true to run the read-only dashboard embedded inside main.py
DASHBOARD_EMBEDDED_ENABLED=false

# Host interface to bind dashboard (0.0.0.0 to accept external/reverse-proxy traffic)
DASHBOARD_HOST=0.0.0.0

# Port to bind dashboard
DASHBOARD_PORT=8000

# Comma-separated list of allowed CORS origins (leave blank for default "*")
DASHBOARD_CORS_ORIGINS=

# Directory containing built frontend static files (or blank for API-only mode)
DASHBOARD_STATIC_DIR=dashboard/static


# ==============================================================================
# 6. OPTIONAL SUBSYSTEMS (OFF BY DEFAULT)
# ==============================================================================

# --- Google Drive Off-Box Backup ---
GDRIVE_BACKUP_ENABLED=false
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
GDRIVE_BACKUP_INTERVAL_HOURS=6
GDRIVE_BACKUP_RETENTION_COUNT=30

# --- CoinDCX Order Update Webhook Receiver ---
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhooks/coindcx/order-update
WEBHOOK_SECRET=


# ==============================================================================
# 7. PAPER TRADING SIMULATION (Optional - for paper mode grids)
# ==============================================================================
PAPER_SLIPPAGE_BPS_MAX=8
PAPER_LATENCY_MIN_SECONDS=1.0
PAPER_LATENCY_MAX_SECONDS=4.0
PAPER_PARTIAL_FILL_PROBABILITY=0.25
