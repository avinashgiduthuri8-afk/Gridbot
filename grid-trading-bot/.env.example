# ==============================================================================
# Manual Grid Trading Bot - Environment Configuration
# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file to version control.
# ==============================================================================

# ---- Telegram ----
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (get it from @userinfobot). Only this user
# (and any IDs in TELEGRAM_ALLOWED_USER_IDS) can control the bot.
TELEGRAM_CHAT_ID=

# Optional: comma-separated list of additional numeric user IDs allowed to
# control the bot. The ID in TELEGRAM_CHAT_ID is always allowed.
TELEGRAM_ALLOWED_USER_IDS=

# ---- CoinDCX ----
COINDCX_API_KEY=
COINDCX_API_SECRET=
COINDCX_BASE_URL=https://api.coindcx.com

# ---- Database ----
DATABASE_PATH=data/grid_bot.db

# ---- Logging ----
LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Risk Management (all values are defaults, overridable per-deployment) ----
# Maximum total capital (INR) allocated across all active grids at once.
MAX_TOTAL_CAPITAL=50000
# Maximum capital (INR) allocated to any single coin's grid.
MAX_CAPITAL_PER_COIN=20000
# Maximum number of grids that may run simultaneously.
MAX_SIMULTANEOUS_GRIDS=5
# Minimum INR wallet balance that must remain free before placing new orders.
MIN_WALLET_BALANCE=500
# Maximum realized loss (INR) allowed in a single day before trading halts.
DAILY_LOSS_LIMIT=2000

# ---- Engine tuning ----
# Seconds between order-monitor polling cycles.
ORDER_POLL_INTERVAL_SECONDS=8
# Seconds between price-check cycles per grid.
PRICE_POLL_INTERVAL_SECONDS=5
# Seconds between periodic Telegram daily summaries (86400 = once/day).
DAILY_SUMMARY_INTERVAL_SECONDS=86400

# ---- Google Drive automatic backup (optional — off by default) ----
# Set to true to enable periodic off-box backups of the SQLite database.
# Requires `pip install google-auth` (see requirements.txt) and a Google
# Cloud service account with its key file downloaded locally. See README
# for the full setup walkthrough.
GDRIVE_BACKUP_ENABLED=false
# Path to the service account JSON key file. Required if enabled.
GDRIVE_SERVICE_ACCOUNT_JSON=
# Google Drive folder ID (from the folder's URL) to upload backups into.
# Must be shared with the service account's email address (Editor access).
# Required if enabled.
GDRIVE_FOLDER_ID=
# How often to run a backup, in hours.
GDRIVE_BACKUP_INTERVAL_HOURS=6
# How many most-recent backups to keep in the Drive folder; older ones are
# automatically deleted.
GDRIVE_BACKUP_RETENTION_COUNT=30

# ---- Paper trading realism (optional — sensible defaults if unset) ----
# Maximum simulated slippage in basis points (1 bps = 0.01%) applied against
# the trader on every paper order — buys fill slightly above the ticker
# price, sells slightly below. 0 disables slippage entirely.
PAPER_SLIPPAGE_BPS_MAX=8
# A simulated paper order stays OPEN for a random delay in this range
# (seconds) before it's eligible to fill at all — mimics real order
# execution latency instead of filling on the very first poll.
PAPER_LATENCY_MIN_SECONDS=1.0
PAPER_LATENCY_MAX_SECONDS=4.0
# Probability (0.0–1.0) that a given paper order passes through an
# intermediate PARTIALLY_FILLED stage before completing, instead of filling
# all at once. Set to 0 to disable partial fills entirely.
PAPER_PARTIAL_FILL_PROBABILITY=0.25

# ---- CoinDCX order-update webhooks (optional, experimental — off by default) ----
# IMPORTANT: this receiver's signature scheme and payload parsing were built
# without access to CoinDCX's live webhook documentation — verify both
# against their current docs before enabling this with real capital. See
# webhooks/server.py's module docstring for exactly what to check. Until
# verified, treat this purely as an accelerant alongside the existing order
# polling (ORDER_POLL_INTERVAL_SECONDS), never a replacement for it — a
# missed or malformed webhook is silently caught by the next poll regardless.
# Requires `pip install aiohttp` (see requirements.txt).
WEBHOOK_ENABLED=false
# Interface to bind the webhook HTTP server on. 0.0.0.0 to accept connections
# from outside the container/host; 127.0.0.1 to only accept local connections
# (e.g. behind your own reverse proxy).
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhooks/coindcx/order-update
# Shared secret used to verify each incoming webhook's HMAC-SHA256 signature.
# Required if WEBHOOK_ENABLED=true. Do NOT reuse COINDCX_API_SECRET; set a dedicated value.
WEBHOOK_SECRET=

# ---- Read-only dashboard (separate service — see Dockerfile.dashboard) ----
# These only apply when running the dashboard process
# (`uvicorn dashboard.app:app`), not the main Telegram bot (main.py).
# Sensible defaults exist for all of these — nothing here is required.
#
# Host/port to bind on. PORT (no prefix) is checked as a fallback so a
# Railway deploy (which injects PORT automatically) works with zero config;
# DASHBOARD_PORT takes priority if you set it explicitly.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Comma-separated list of allowed CORS origins for the API, e.g.
# https://your-dashboard.example.com. Defaults to "*" (open) — fine for a
# dashboard served from the same origin as its API (the default Docker
# setup), tighten this if you split frontend/backend across two origins.
DASHBOARD_CORS_ORIGINS=
# Path to a built frontend (`vite build` output — index.html + assets/) to
# serve directly from this same process. Defaults to dashboard/static,
# which is exactly where Dockerfile.dashboard copies the frontend build to.
# Leave unset/point at a missing directory to run API-only (e.g. in tests).
DASHBOARD_STATIC_DIR=dashboard/static
